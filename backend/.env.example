DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agritech
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

GEE_PROJECT=your-google-cloud-project-id
GEE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-google-cloud-project-id.iam.gserviceaccount.com
GEE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-google-cloud-project-id","private_key_id":"replace-me","private_key":"-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n","client_email":"your-service-account@your-google-cloud-project-id.iam.gserviceaccount.com","client_id":"replace-me","token_uri":"https://oauth2.googleapis.com/token"}

SATELLITE_CACHE_TTL_DAYS=5
SATELLITE_COMPOSITE_WINDOW_DAYS=14
SATELLITE_SCHEDULER_INTERVAL_DAYS=5
SATELLITE_SCHEDULER_INITIAL_DELAY_SECONDS=30
SATELLITE_SCHEDULER_ENABLED=true
SATELLITE_BATCH_SIZE=25
SATELLITE_BUFFER_METERS=10
SATELLITE_SIMPLIFY_TOLERANCE_METERS=3
SATELLITE_CLOUD_FILTER_PCT=20
SATELLITE_DEGRADED_CLOUD_THRESHOLD_PCT=12
SATELLITE_REDUCTION_SCALE_METERS=10
SATELLITE_REDUCE_MAX_PIXELS=2000000
SATELLITE_ENABLE_TILE_URLS=false
SATELLITE_TILE_PALETTE=#8b0000,#d95f0e,#fdd835,#66bb6a,#1b5e20
SATELLITE_REQUEST_PRIORITY=10
SATELLITE_SCHEDULE_PRIORITY=100
SATELLITE_REFRESH_THROTTLE_SECONDS=300
SATELLITE_JOB_POLL_INTERVAL_SECONDS=1
SATELLITE_JOB_STAGGER_SECONDS=0.35
SATELLITE_JOB_TIMEOUT_SECONDS=900
SATELLITE_WORKER_COUNT=2
SATELLITE_GEE_TIMEOUT_SECONDS=90
